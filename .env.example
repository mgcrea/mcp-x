# --- Credentials -------------------------------------------------------------
# The app-only Bearer token. Enough for everything public: post lookup, search,
# profiles, user timelines. Create an app at https://console.x.com (Type of App: Native App),
# then copy the Bearer Token from its Keys and Tokens screen.
X_BEARER_TOKEN=

# OAuth 2.0, needed ONLY for bookmarks, your home timeline, and API writes.
# Choose Type of App = Native App when creating it: that yields a public PKCE
# client with no secret, which is what this server expects. Then run
# `x-mcp login`. Enroll the app in the Pay-per-use package and Production
# environment, or every call after login fails 403 client-not-enrolled.
# X_CLIENT_ID=
# X_CLIENT_SECRET=            # confidential clients only; Native Apps omit it

# Must match the callback URL registered in the console BYTE FOR BYTE.
# X's docs say to use 127.0.0.1 rather than localhost for local development.
# X_REDIRECT_URI=http://127.0.0.1:8723/callback

# Space- or comma-separated. tweet.write is added automatically when the paid
# write backend is on, so a reader never asks for a permission it cannot use.
# X_SCOPES=tweet.read,users.read,bookmark.read,offline.access

# Where the rotating refresh token is stored (mode 600).
# Defaults to <config dir>/tokens.json.
# X_TOKEN_FILE=

# --- Cost control ------------------------------------------------------------
# X is pay-per-use since 2026-02-06: ~$0.005 per post read, ~$0.010 per user
# read, ~$0.001 for your own data. There is no free tier for new developers.

# Default page size. Deliberately low — 100 results is about $0.50.
# X_DEFAULT_MAX_RESULTS=10

# Hard ceiling for this process. A read whose estimate would cross it fails
# locally, before the request goes out.
# X_MONTHLY_BUDGET_USD=25

# Caches reads for the current UTC day, mirroring X's own dedup window: a repeat
# read of the same id would not be billed again anyway, so a hit is free.
# X_CACHE_ENABLED=true
# X_CACHE_MAX_ENTRIES=5000

# --- Capabilities ------------------------------------------------------------
# Posting is FREE by default: x_compose_post returns an x.com/intent/tweet URL
# you click. Nothing below is needed for that.

# Register the PAID write tools (x_create_post, x_delete_post). Needs BOTH.
# x_create_post costs ~$0.015, or ~$0.200 if the post contains a URL.
# X_ALLOW_WRITES=1
# X_WRITE_BACKEND=api

# Open the composer in a browser automatically. Ignored when headless.
# X_AUTO_OPEN_BROWSER=true

# Register x_search_all (full archive back to 2006). Needs a paid access tier
# and is limited to one request per second.
# X_ENABLE_FULL_ARCHIVE=1

# --- X Ads API ----------------------------------------------------------------
# Advertising campaigns, targeting and performance analytics. Separate from
# everything above: the Ads API needs its own approval from X, even though it
# rides the same OAuth 2.0 login. Two steps trip everyone up:
#   1. At console.x.com, open the app and attach the Ads Project under Project
#      Access. Then request access using X's Ads API Access Form.
#   2. Once approved, run `x-mcp login` AGAIN. A token minted before
#      approval authenticates fine and then fails every ads call.
# Requires X_CLIENT_ID — an app-only Bearer token cannot reach the Ads API.
# X_ADS_ENABLED=1

# Register the tools that CREATE, CHANGE and DELETE campaigns. Independent of
# X_ALLOW_WRITES, which governs posting rather than advertising. Creates are
# made PAUSED unless a call explicitly asks otherwise, so nothing starts
# spending on its own.
# X_ADS_ALLOW_WRITES=1

# The free sandbox — throwaway accounts and funding instruments, no real money.
# Note the host: X's docs say ads-api-sandbox.x.com, which does not resolve.
# Defaults to https://ads-api.x.com (production).
# X_ADS_BASE_URL=https://ads-api-sandbox.twitter.com

# Skip the account lookup, and disambiguate when the login can reach several.
# X_ADS_ACCOUNT_ID=18ce54d4x5t

# Ceiling on an async analytics result download, before and after decompression.
# X_ADS_MAX_DOWNLOAD_BYTES=25000000

# Override X's price table without a config file, as a JSON object. Keys are
# the camelCase names from the README's cost table (postRead, userRead, ...).
# X_PRICING={"postRead": 0.005}

# --- Misc --------------------------------------------------------------------
# X_MAX_RETRIES=3
# X_BASE_URL=https://api.x.com
# X_CONFIG=~/.config/x/config.json
# X_DEBUG=1
